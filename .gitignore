# Media / heavy binaries — keep the repo text-only
*.mp4
*.mov
*.avi
*.mkv
*.wav
*.aif
*.aiff
*.mp3
*.ogg
*.flac
*.m4a
*.prproj
*.aep
*.psd
*.ai
*.zip

# Episode working assets (archive downloads, exports, renders)
episodes/**/assets/*
!episodes/**/assets/README.md
!episodes/**/assets/_index.json

# Third-party transcripts used for format analysis — copyright, keep local only
research/dieck-docs/transcripts/*
!research/dieck-docs/transcripts/README.txt

# Reference books (PDFs + markitdown conversions) — copyright, research use only, keep local
research/_books/*
!research/_books/README.md

# Python
__pycache__/
*.pyc

# Claude Code local settings (per-machine tool permissions, not project config)
.claude/settings.local.json

# OS / editor
Thumbs.db
Desktop.ini
.DS_Store
*.tmp
~$*
.vscode/
.idea/

# Generated PDFs
ideas/*.pdf

# API keys for tools/pull_assets.py
tools/.env

# Stage 7 style pass — generated, regenerate with tools/pull_assets.py
# (07-style-pass.md, 07-picks.txt, 07-selection.md ARE tracked — the pass record)
episodes/**/07-style-pass.html

# Stage 9 edit — generated / transient (media already covered above)
# (07c-edit.md, 07c-review.txt, 09-timeline.json, 09-decisions.txt ARE tracked — the edit record)
brand/assets/music/candidates.md
episodes/**/*.cuts.md
episodes/**/*.words.json
episodes/**/07c-edit.html
episodes/**/09-edit.html
episodes/**/09-rough.mp4
episodes/**/09-wave.b64
episodes/**/09-vo.m4a
episodes/**/09-take.mp4
episodes/**/_wave.png
episodes/**/*.done
episodes/**/09-timeline.*.bak.json
episodes/**/09-resync.flag

# Review pages — generated (the exported *.txt records ARE tracked)
ideas/idea-review.html
episodes/**/02-research.html
episodes/**/05-script.html
episodes/**/09-edit.html
episodes/**/10-package.html
episodes/**/12-metrics.html

# Dashboard — generated / transient (tools/dash.py, tools/serve.py)
dashboard.html
cost.html
episodes/_queue.json
episodes/_loop.json
episodes/**/_exports/
episodes/**/_folds/

# Desktop launcher shortcut — bakes in an absolute local path, not portable
*.lnk
