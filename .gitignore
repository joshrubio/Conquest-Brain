# Media / heavy binaries — keep the repo text-only
*.mp4
*.mov
*.avi
*.mkv
*.wav
*.aif
*.aiff
*.mp3
*.prproj
*.aep
*.psd
*.ai
*.zip

# Episode working assets (archive downloads, exports, renders)
episodes/**/assets/*
!episodes/**/assets/README.md

# Third-party transcripts used for format analysis — copyright, keep local only
research/dieck-docs/transcripts/*
!research/dieck-docs/transcripts/README.txt

# Python
__pycache__/
*.pyc

# OS / editor
Thumbs.db
Desktop.ini
.DS_Store
*.tmp
~$*
.vscode/
.idea/

# Generated pitch PDFs (regenerate with tools/build_idea_pitch.py)
ideas/*.pdf

# API keys for tools/pull_assets.py
tools/.env

# Stage 7 photography pass — generated, regenerate with tools/pull_assets.py
# (07-photography-pass.md, 07-picks.txt, 07-selection.md ARE tracked — the pass record)
episodes/**/07-photography-pass.html

# Stage 9 edit — generated / transient (media already covered above)
# (07c-edit.md and brand/assets/music/LICENSES.md ARE tracked)
brand/assets/music/candidates.md
episodes/**/*.cuts.md
